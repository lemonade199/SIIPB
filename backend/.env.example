APP_ENV=development
APP_DEBUG=true
SECRET_KEY=change-this-in-production-to-a-very-secure-random-key

# Database Existing (MariaDB 13)
DATABASE_URL=mariadb+pymysql://root:password@127.0.0.1:3306/siipb?charset=utf8mb4

# Redis (Celery Broker & Caching)
REDIS_URL=redis://127.0.0.1:6379/0

# JWT Authentication
JWT_SECRET_KEY=change-jwt-secret-in-production
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=7

# OAuth 2.0 / OIDC (Google SSO)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# SMTP Email Notification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
SMTP_SENDER_EMAIL=sarpras@siipb.sch.id
SMTP_SENDER_NAME=SIIPB Sarpras IT

# MinIO / S3 Object Storage
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=siipb-uploads
S3_SECURE=false

# Server
PORT=5000
HOST=0.0.0.0

# Pengiriman email: sync (langsung, tanpa worker — pengembangan) | celery (production)
NOTIFICATION_DISPATCH=sync
# Origin frontend yang diizinkan (pisahkan koma). Production: https://siipb.instansi.go.id
CORS_ORIGINS=http://localhost:3000
# Tujuan redirect setelah login SSO
FRONTEND_URL=http://localhost:3000
MAX_UPLOAD_MB=5
# Database khusus pytest (dibuat ulang otomatis setiap sesi tes)
TEST_DATABASE_URL=mariadb+pymysql://root:password@127.0.0.1:3306/siipb_test?charset=utf8mb4
