# Sumber data: "mock" (data contoh di browser, tanpa backend) atau "api" (Flask REST API)
NEXT_PUBLIC_DATA_SOURCE=mock

# Base URL Flask REST API SIIPB (blueprint memakai prefix /api/v1) — dipakai bila DATA_SOURCE=api
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# Nama instansi yang tampil sebelum pengaturan diubah (opsional, mode api)
# NEXT_PUBLIC_INSTITUTION=SMK Negeri 1
