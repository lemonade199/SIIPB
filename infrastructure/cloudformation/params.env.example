# Salin menjadi params.env (di-ignore git):  cp params.env.example params.env
# Dibaca oleh deploy-stacks.sh. JANGAN taruh password di file ini — berikan lewat variabel lingkungan:
#   export SEED_ADMIN_PASSWORD='...'   (wajib saat stack data pertama kali dibuat)
#   export SMTP_PASSWORD='...'         (opsional; kosong = mode simulasi email)
#   export GOOGLE_CLIENT_SECRET='...'  (opsional, SSO)

PROJECT=siipb
ENVIRONMENT=production
# AWS Academy / Learner Lab hanya mengizinkan us-east-1 (atau us-west-2)
AWS_REGION=us-east-1

# ---- jaringan
# IP publik Anda + /32 (curl https://checkip.amazonaws.com) — satu-satunya sumber SSH
ADMIN_CIDR=203.0.113.10/32
# 80/443 publik (Let's Encrypt butuh port 80 publik)
WEB_INGRESS_CIDR=0.0.0.0/0

# ---- EC2
INSTANCE_TYPE=t3.small
ROOT_VOLUME_SIZE=30
SSH_PUBLIC_KEY_FILE=~/.ssh/siipb_deploy.pub

# ---- domain & SSL
DOMAIN_NAME=averus.my.id
# isi bila averus.my.id dikelola Route 53; kosong = buat record A manual di registrar
HOSTED_ZONE_ID=
LETSENCRYPT_EMAIL=admin@averus.my.id

# ---- RDS
DB_INSTANCE_CLASS=db.t4g.micro
DB_ENGINE_VERSION=11.4
DB_ALLOCATED_STORAGE=20
DB_BACKUP_RETENTION_DAYS=7
DB_MULTI_AZ=false
DB_DELETION_PROTECTION=true

# ---- SMTP (password lewat env SMTP_PASSWORD)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_SENDER_EMAIL=no-reply@averus.my.id
SMTP_SENDER_NAME="SIIPB Sarpras IT"
GOOGLE_CLIENT_ID=

# ---- IAM
# AWS Academy (tidak boleh membuat IAM role): pakai instance profile bawaan lab.
# Akun AWS biasa: kosongkan agar template membuat role sendiri.
EC2_INSTANCE_PROFILE=LabInstanceProfile

# ---- CI/CD
# AWS Academy: false (GitHub memakai access key + session token lab). Akun biasa: true (OIDC).
CREATE_GITHUB_DEPLOY_ROLE=false
GITHUB_REPOSITORY=lemonade199/SIIPB
GITHUB_BRANCH=main
# false bila OIDC provider token.actions.githubusercontent.com sudah ada di akun AWS
CREATE_GITHUB_OIDC_PROVIDER=true

# ---- monitoring
ALARM_EMAIL=devops@averus.my.id
# hanya untuk ./deploy-stacks.sh billing (akun AWS biasa; tidak tersedia di AWS Academy)
BILLING_THRESHOLD_USD=50
INSTITUTION_NAME="Instansi Contoh"
