# Salin menjadi terraform.tfvars (di-ignore git) lalu sesuaikan.
# Nilai rahasia (seed_admin_password, smtp_password, google_client_secret) LEBIH BAIK diberikan lewat
# variabel lingkungan agar tidak tersimpan di disk:
#   export TF_VAR_seed_admin_password='...'   (PowerShell: $env:TF_VAR_seed_admin_password='...')
#   export TF_VAR_smtp_password='...'

aws_region  = "ap-southeast-1"
project     = "siipb"
environment = "production"

# IP publik Anda (curl https://checkip.amazonaws.com) + /32 — satu-satunya sumber SSH
admin_cidrs = ["203.0.113.10/32"]

# 80/443 publik. Untuk UAT internal saja, ganti dengan IP Anda (catatan: Let's Encrypt butuh port 80 publik).
web_ingress_cidrs = ["0.0.0.0/0"]

# Isi public key (cat ~/.ssh/siipb_deploy.pub)
ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... siipb-deploy"

instance_type = "t3.small"

domain_name       = "siipb.averus.my.id"
route53_zone_id   = "" # isi bila averus.my.id dikelola Route 53; kosong = buat record A manual
letsencrypt_email = "admin@averus.my.id"

db_instance_class        = "db.t4g.micro"
db_backup_retention_days = 7
db_deletion_protection   = true

institution_name  = "Instansi Contoh"
smtp_host         = "smtp.gmail.com"
smtp_port         = 587
smtp_username     = ""
smtp_sender_email = "no-reply@averus.my.id"

github_repository           = "lemonade199/SIIPB"
create_github_oidc_provider = true

alarm_email                 = "devops@averus.my.id"
billing_alarm_threshold_usd = 50
