#!/bin/bash
# Bootstrap EC2 SIIPB (dijalankan sekali oleh cloud-init saat instans pertama kali menyala).
# Log: /var/log/siipb-bootstrap.log
set -euxo pipefail
exec > >(tee -a /var/log/siipb-bootstrap.log) 2>&1
export DEBIAN_FRONTEND=noninteractive

# ---------------------------------------------------------------- paket dasar
apt-get update -y
apt-get install -y ca-certificates curl unzip jq cron \
  nginx certbot \
  docker.io docker-compose-v2 \
  mariadb-client
timedatectl set-timezone Asia/Jakarta

# AWS CLI v2
curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
unzip -q -o /tmp/awscliv2.zip -d /tmp
/tmp/aws/install --update
rm -rf /tmp/aws /tmp/awscliv2.zip

# swap 2 GiB (build-free, tapi Next.js + Gunicorn + Celery di instans kecil butuh cadangan RAM)
if [ ! -f /swapfile ]; then
  fallocate -l 2G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

# ---------------------------------------------------------------- Docker
systemctl enable --now docker
usermod -aG docker ubuntu

# ---------------------------------------------------------------- konfigurasi SIIPB
mkdir -p /etc/siipb /opt/siipb/scripts /opt/siipb/nginx/snippets /opt/siipb/backups \
         /opt/siipb/uploads/assets /opt/siipb/uploads/evidence /opt/siipb/uploads/documents \
         /var/www/certbot
cat > /etc/siipb/siipb.conf <<'EOF'
AWS_REGION=${aws_region}
AWS_DEFAULT_REGION=${aws_region}
APP_DOMAIN=${domain_name}
LETSENCRYPT_EMAIL=${letsencrypt_email}
SECRET_ID=${secret_id}
ECR_REGISTRY=${ecr_registry}
S3_BUCKET=${s3_bucket}
LOG_GROUP=${app_log_group}
APP_DIR=/opt/siipb
EOF
chmod 644 /etc/siipb/siipb.conf

# pulihkan berkas unggahan dari S3 (bila instans diganti)
/usr/local/bin/aws s3 sync "s3://${s3_bucket}/uploads/" /opt/siipb/uploads/ --only-show-errors || true

# container berjalan sebagai uid 10001 (user siipb di Dockerfile)
chown -R 10001:10001 /opt/siipb/uploads /opt/siipb/backups
chown ubuntu:ubuntu /opt/siipb
touch /var/log/siipb-deploy.log && chown ubuntu:ubuntu /var/log/siipb-deploy.log

# ---------------------------------------------------------------- Nginx (reverse proxy, HTTP dulu)
# HTTPS diaktifkan setelah DNS mengarah ke Elastic IP: /opt/siipb/scripts/setup-ssl.sh
# salinan sumber di /opt/siipb (diperbarui setiap deploy GitHub Actions)
echo '${nginx_locations_b64}' | base64 -d > /opt/siipb/nginx/snippets/siipb-locations.conf
echo '${nginx_http_b64}' | base64 -d > /opt/siipb/nginx/siipb.http.conf
echo '${nginx_https_b64}' | base64 -d > /opt/siipb/nginx/siipb.https.conf
echo '${setup_ssl_b64}' | base64 -d > /opt/siipb/scripts/setup-ssl.sh
chmod +x /opt/siipb/scripts/setup-ssl.sh
chown -R ubuntu:ubuntu /opt/siipb/nginx /opt/siipb/scripts

install -m 644 /opt/siipb/nginx/snippets/siipb-locations.conf /etc/nginx/snippets/siipb-locations.conf
sed "s/__DOMAIN__/${domain_name}/g" /opt/siipb/nginx/siipb.http.conf > /etc/nginx/sites-available/siipb.conf
ln -sf /etc/nginx/sites-available/siipb.conf /etc/nginx/sites-enabled/siipb.conf
rm -f /etc/nginx/sites-enabled/default
sed -i 's/# server_tokens off;/server_tokens off;/' /etc/nginx/nginx.conf
nginx -t
systemctl enable nginx
systemctl reload nginx

# Certbot: reload Nginx otomatis setelah perpanjangan sertifikat (timer certbot.timer bawaan paket)
mkdir -p /etc/letsencrypt/renewal-hooks/deploy
printf '#!/bin/sh\nsystemctl reload nginx\n' > /etc/letsencrypt/renewal-hooks/deploy/reload-nginx.sh
chmod +x /etc/letsencrypt/renewal-hooks/deploy/reload-nginx.sh

# ---------------------------------------------------------------- CloudWatch Agent
curl -fsSL "https://s3.amazonaws.com/amazoncloudwatch-agent/ubuntu/amd64/latest/amazon-cloudwatch-agent.deb" -o /tmp/cwagent.deb
dpkg -i -E /tmp/cwagent.deb
rm -f /tmp/cwagent.deb
echo '${cwagent_b64}' | base64 -d > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -s \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json
systemctl enable amazon-cloudwatch-agent

# ---------------------------------------------------------------- sinkronisasi S3
cat > /etc/cron.d/siipb-s3-sync <<'EOF'
SHELL=/bin/bash
# foto/berkas barang -> S3 tiap 15 menit; backup harian (Celery 01.00 WIB) -> S3 pukul 02.30 WIB
*/15 * * * * root /usr/local/bin/aws s3 sync /opt/siipb/uploads s3://${s3_bucket}/uploads/ --only-show-errors >> /var/log/siipb-s3-sync.log 2>&1
30 2 * * * root /usr/local/bin/aws s3 sync /opt/siipb/backups s3://${s3_bucket}/backups/ --only-show-errors >> /var/log/siipb-s3-sync.log 2>&1
EOF
chmod 644 /etc/cron.d/siipb-s3-sync

echo "SIIPB bootstrap selesai $(date -Is)" > /opt/siipb/.bootstrap-done
