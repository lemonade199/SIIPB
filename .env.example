# ==========================================================================
# SIIPB — konfigurasi docker compose
#   cp .env.example .env   lalu GANTI semua nilai "ganti-..." sebelum dipakai.
# Rahasia hanya disimpan di .env / secret manager — jangan di-commit (lihat .gitignore).
# ==========================================================================

# URL publik aplikasi (dipakai CORS & redirect SSO). Production: https://siipb.instansi.go.id
PUBLIC_URL=http://localhost
HTTP_PORT=80
HTTPS_PORT=443
# nginx.conf (HTTP) | nginx.https.conf (HTTPS; sertifikat di infrastructure/nginx/certs)
NGINX_CONF=nginx.conf
TZ=Asia/Jakarta
INSTITUTION_NAME=Instansi Contoh

# --- Database MariaDB ---
DB_NAME=siipb
DB_USER=siipb
DB_PASSWORD=ganti-password-db
DB_ROOT_PASSWORD=ganti-password-root

# --- Keamanan (string acak panjang: python -c "import secrets;print(secrets.token_urlsafe(48))") ---
SECRET_KEY=ganti-secret-key
JWT_SECRET_KEY=ganti-jwt-secret
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7
MAX_UPLOAD_MB=5

# --- Akun awal (dibuat sekali oleh seed; WAJIB ganti kata sandi setelah login pertama) ---
SEED_ADMIN_PASSWORD=ganti-Admin123
# 1 = buat juga akun petugas/pimpinan + data contoh (untuk demo/UAT)
SEED_DEMO_DATA=0
SEED_PETUGAS_PASSWORD=
SEED_PIMPINAN_PASSWORD=
# tampilkan daftar akun awal di halaman login (hanya untuk demo)
SHOW_DEMO_ACCOUNTS=false

# --- SMTP (dapat juga diatur dari menu Pengaturan > SMTP; kata sandi disimpan terenkripsi) ---
# Kosongkan SMTP_USERNAME/SMTP_PASSWORD untuk mode simulasi (email tidak benar-benar dikirim).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=no-reply@siipb.local
SMTP_SENDER_NAME=SIIPB Sarpras IT

# --- SSO OAuth 2.0 / OpenID Connect (opsional) ---
# Redirect URI di Identity Provider: ${PUBLIC_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
