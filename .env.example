# ========================================================
# SIIPB DOCKER & ENVIRONMENT CONFIGURATION
# ========================================================

# Database Configuration (MariaDB)
DB_PASSWORD=123
DB_NAME=siipb
DATABASE_URL=mariadb+pymysql://root:123@mariadb:3306/siipb?charset=utf8mb4

# Redis (Message Broker & Cache)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Security Secrets (Ganti dengan string acak panjang di production)
SECRET_KEY=siipb-super-secret-production-key-change-me
JWT_SECRET_KEY=siipb-jwt-secret-key-change-me

# SMTP Email Notification (Untuk pengingat jatuh tempo H-3, H-1, H, Overdue)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_SENDER_EMAIL=sarpras@siipb.sch.id
SMTP_SENDER_NAME=SIIPB Sarpras IT

# Port Services
PORT=5000
